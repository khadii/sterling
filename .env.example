NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001
SWAGGER_PATH=docs
ENABLE_SWAGGER=true

# Keep false for unrestricted localhost testing. Set true in production.
THROTTLE_ENABLED=false
THROTTLE_TTL_MS=60000
THROTTLE_GLOBAL_LIMIT=100

# Supabase: Project Settings > API Keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

EMAIL_CONFIRM_REDIRECT_URL=http://localhost:3001/auth/confirm
PASSWORD_RESET_REDIRECT_URL=http://localhost:3001/auth/reset-password

# Optional fallback transactional email provider (any SMTP-compatible service)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_MAX_RETRIES=2
